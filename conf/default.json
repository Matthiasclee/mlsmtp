{
  "mailname": "localhost",
  "esmtp_enable": false,
  "require_helo": true,
  "transport_rules_file": "conf/transport_rules.json",
  "database": {
    "adapter": "SMTPServer::Database::MySQL",
    "path": "queue.db",
    "username": null,
    "password": null
  },
  "mail_storage": {
    "adapter": "SMTPServer::Storage::MailDir",
    "config": {
      "path": "maildir/%u",
      "create_nonexistent_dirs": false
    }
  },
  "banner": {
    "include_esmtp_status": true,
    "banner_server_name": "MLSMTP",
    "additional_text": null,
    "message_override": false
  },
  "socket": {
    "restart_delay": 0.2
  },
  "servers": [
    {
      "host": "0.0.0.0",
      "port": 2525,
      "encryption": "off",
      "autostart": true
    }
  ]
}
