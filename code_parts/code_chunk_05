          )
          context.send_response(message)
          return
        end

        message = SMTP::Response.new(
          status: :positive_completed,
          category: :mail_system,
          message: "2.1.0 Ok"
        )
        context.send_response(message)

        context.mailfrom = args[0]
        context.rcptto = []

        Logger.log "Sender: `#{args[0]}`", origin: context.logger_origin, verbosity: 5
      end
    end
  end
